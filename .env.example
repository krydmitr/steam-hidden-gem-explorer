# Template for .env - this file IS committed, so it must never hold a real key.
#
# To set the project up on a new machine: copy this file to .env, then paste
# your key from https://console.anthropic.com/settings/keys in place of the
# placeholder.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

ANTHROPIC_API_KEY=sk-ant-paste-your-key-here
